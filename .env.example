DATABASE_URL=sqlite:///./runtime/hiddenchain.db
JWT_SECRET=replace-this-in-production
SIGNING_SECRET=replace-this-in-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=demo
TEST_FIXTURE_SEED=false
DEMO_CATALOG_SEED=true
DEMO_BUSINESS_SEED=true
TEST_COMPUTE_DELAY_MS=0
OPA_LOCAL_FALLBACK=true

# Optional OpenTelemetry tracing. Set an OTLP HTTP endpoint in deployments.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hiddenchain-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_CONSOLE_EXPORT=false

# Redacted OpenLineage RunEvents are written to the runtime volume by default.
OPENLINEAGE_ENABLED=true
OPENLINEAGE_NAMESPACE=hiddenchain
OPENLINEAGE_PATH=./runtime/lineage/events.jsonl
OPENLINEAGE_HTTP_URL=

# Per-provider/group load bound used by the OpenDP differential privacy adapter.
DP_MAX_LOAD_MW=100

# Optional: audit explanation only. Never put this key in the frontend.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=800

# Optional FISCO BCOS evidence anchor; leave empty to keep the explicit local DEMO mode.
FISCO_BCOS_RPC_URL=
FISCO_BCOS_RELAY_URL=
FISCO_BCOS_GROUP_ID=group0
FISCO_BCOS_NODE_ID=
FISCO_BCOS_CONTRACT_ADDRESS=
