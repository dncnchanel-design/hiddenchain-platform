# Generate unique values before deployment. Never commit the real .env.production file.
JWT_SECRET=replace-with-at-least-32-random-characters
SIGNING_SECRET=replace-with-at-least-32-random-characters
APP_ENV=production
GIT_COMMIT=replace-with-full-git-commit-sha

# Set the fixed public domain after its DNS A record points to the server.
PUBLIC_DOMAIN=power.example.com
CORS_ORIGINS=https://power.example.com
TEST_FIXTURE_SEED=false
DEMO_CATALOG_SEED=false
DEMO_BUSINESS_SEED=false
TEST_COMPUTE_DELAY_MS=0
OPA_URL=http://opa:8181
OPA_POLICY_PATH=/v1/data/hiddenchain/decision
OPA_TIMEOUT_SECONDS=1.0
OPA_LOCAL_FALLBACK=false
EXECUTION_POLICY_PATH=/app/policy/energy_execution_policy.json
EXECUTION_AUDIT_WORKERS=2

# Required subject-connector trust configuration. Use one connector identity,
# key, and storage boundary per organization and energy domain.
PLATFORM_SIGNING_PRIVATE_KEY=replace-with-base64-ed25519-private-key
SUBJECT_NODE_ENDPOINTS_JSON={"org-example":"https://connector.example.com"}
# Use the same map when browser and server share a public endpoint. Set a
# distinct public map when the server uses an internal network address.
SUBJECT_NODE_BROWSER_ENDPOINTS_JSON={"org-example":"https://connector.example.com"}
SUBJECT_NODE_IDS_JSON={"org-example":"connector-org-example"}
SUBJECT_NODE_PUBLIC_KEYS_JSON={"org-example":"replace-with-base64-ed25519-public-key"}
# Optional retired keys preserve offline verification after a connector rotates
# its active key. Values are arrays; never put private keys in this map.
SUBJECT_NODE_PUBLIC_KEY_RINGS_JSON={}
CONNECTOR_TIMEOUT_SECONDS=15

# White-label identity. Leave optional assets empty to use the built-in wordmark.
PRODUCT_NAME=隐链明算
PRODUCT_SHORT_NAME=隐链明算
PRODUCT_SUBTITLE=多能源可信数据空间
PRODUCT_LOGO=
PRODUCT_LOGO_COMPACT=
PRODUCT_FAVICON=
BRAND_THEME_ID=trusted-space-navy
BRAND_PRIMARY="#1768A0"
CUSTOMER_NAME=
OPERATOR_NAME=
BUILDER_NAME=
COPYRIGHT_OWNER=
COPYRIGHT_YEAR=
SUPPORT_NAME=
SUPPORT_CONTACT=
ENVIRONMENT_NAME=
LOGIN_NOTICE=

# Optional public wallet-address bindings for DID login; never include a wallet private key.
DID_WALLET_BINDINGS_JSON={}

# SlowAPI login protection for this single-instance reference deployment.
# Shared Redis-backed limiting remains BLOCKED until both the client dependency
# and an external managed service are added and verified; do not substitute an
# unverified Redis URL here.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
AUTH_LOGIN_RATE_LIMIT=10/minute

# Optional OpenTelemetry exporter. Leave disabled until an OTLP collector is ready.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hiddenchain-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_CONSOLE_EXPORT=false

# Keep lineage on the persistent runtime volume; only redacted hashes/references are written.
OPENLINEAGE_ENABLED=true
OPENLINEAGE_NAMESPACE=hiddenchain
OPENLINEAGE_PATH=/app/runtime/lineage/events.jsonl
OPENLINEAGE_HTTP_URL=
DP_MAX_LOAD_MW=100

# Optional: audit explanation only. Keep the key in this server-side env file.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=800

# Optional external evidence anchoring. All five values are required together.
# The platform holds no FISCO private key; FISCO_BCOS_RELAY_URL must point to
# an independently operated signer/relay that is idempotent by idempotency_key.
FISCO_BCOS_RPC_URL=
FISCO_BCOS_RELAY_URL=
FISCO_BCOS_GROUP_ID=group0
FISCO_BCOS_NODE_ID=
FISCO_BCOS_CONTRACT_ADDRESS=
FISCO_BCOS_TIMEOUT_SECONDS=10
FISCO_BCOS_RECEIPT_POLL_ATTEMPTS=10
FISCO_BCOS_RECEIPT_POLL_INTERVAL_SECONDS=0.5

# Bind the Nginx container only to loopback when Cloudflare Tunnel is used.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Required only for the Cloudflare named-tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-token-from-cloudflare
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
